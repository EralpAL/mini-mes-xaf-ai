    </Actions>
  </ActionDesign>
  <Validation>
    <Rules>
      <RuleCriteria Id="ProductionOrder_PlannedQuantityGreaterThanZero" CustomMessageTemplate="Planlanan miktar sıfırdan büyük olmalıdır." />
      <RuleCriteria Id="ProductionEntry_QuantityEntered" CustomMessageTemplate="Gerçekleşen miktar, fire miktarı veya her ikisi girilmelidir." />
      <RuleCriteria Id="ProductionEntry_ScrapReasonRequired" CustomMessageTemplate="Fire miktarı girildiğinde fire nedeni belirtilmelidir." />
      <RuleCriteria Id="DowntimeLog_DurationGreaterThanZero" CustomMessageTemplate="Duruş süresi sıfır dakikadan büyük olmalıdır." />
      <RuleValueComparison Id="ProductionEntry_EndTimeNotBeforeStartTime" CustomMessageTemplate="Bitiş zamanı başlangıç zamanından önce olamaz." />
    </Rules>
  </Validation>
