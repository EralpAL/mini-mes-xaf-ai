<?xml version="1.0" ?>
<Application Title="MiniMes" PreferredLanguage="(User language)">
  <BOModel>
    <Class Name="DevExpress.Persistent.BaseImpl.PermissionPolicy.PermissionPolicyUser" Caption="Base User" />
  </BOModel>
  <Options>
    <LayoutManagerOptions RequiredFieldMark="*" />
  </Options>
  <Views>
    <ListView Id="ApplicationUser_ListView" Caption="Users" />
    <DetailView Id="AiAnalysisRecord_DetailView" Caption="AI Gecikme Analizi" AllowEdit="False">
      <Items>
        <PropertyEditor Id="AnalysisDate" Index="0" />
        <PropertyEditor Id="ModelName" Index="1" Caption="Kullanılan Model" />
        <PropertyEditor Id="AnalysisText" Index="2" RowCount="9" Caption="Gecikme Analizi" />
        <PropertyEditor Id="OptimizationRecommendation" Index="3" RowCount="9" Caption="Optimizasyon Önerisi" />
        <PropertyEditor Id="ProductionOrder" Index="-1" Removed="True" />
      </Items>
      <Layout>
        <LayoutGroup Id="Main" Direction="Vertical" ShowCaption="False">
          <LayoutItem Id="AnalysisDate" ViewItem="AnalysisDate" Index="0" />
          <LayoutItem Id="ModelName" ViewItem="ModelName" Index="1" />
          <LayoutItem Id="AnalysisText" ViewItem="AnalysisText" Index="2" RelativeSize="100" />
          <LayoutItem Id="OptimizationRecommendation" ViewItem="OptimizationRecommendation" Index="3" RelativeSize="100" />
        </LayoutGroup>
      </Layout>
    </DetailView>
    <ListView Id="AiAnalysisRecord_ListView" Caption="AI Analiz Kayıtları" AllowNew="False" AllowDelete="False" AllowEdit="False" AllowLink="False" AllowUnlink="False">
      <Columns>
        <ColumnInfo Id="AnalysisDate" Index="0" />
        <ColumnInfo Id="ProductionOrder" Index="1" />
        <ColumnInfo Id="ModelName" Index="2" Caption="Kullanılan Model" />
      </Columns>
    </ListView>
    <ListView Id="ProductionOrder_AiAnalysisRecords_ListView" Caption="AI Analiz Geçmişi" AllowNew="False" AllowDelete="False" AllowEdit="False" AllowLink="False" AllowUnlink="False">
      <Columns>
        <ColumnInfo Id="AnalysisDate" Index="0" />
        <ColumnInfo Id="ModelName" Index="1" Caption="Kullanılan Model" />
        <ColumnInfo Id="ProductionOrder" Index="-1" Removed="True" />
        <ColumnInfo Id="AnalysisText" Index="-1" Removed="True" />
        <ColumnInfo Id="OptimizationRecommendation" Index="-1" Removed="True" />
      </Columns>
    </ListView>
  </Views>
</Application>
